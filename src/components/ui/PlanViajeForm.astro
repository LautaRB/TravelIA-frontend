---

---

<div class="form-container">
  <h2>Planificá tu próximo viaje</h2>
  <form id="plan-viaje-form">
    <div class="input-group">
      <label for="titulo">Nombre del Viaje</label>
      <input
        type="text"
        id="titulo"
        name="titulo"
        placeholder="Ej: Eurotrip 2025"
        autocomplete="off"
        required
      />
    </div>
    <div class="input-group autocomplete-wrapper">
      <label for="origen">¿Desde dónde salís?</label>
      <input
        type="text"
        id="origen"
        name="origen"
        placeholder="Ej: Buenos Aires, Argentina"
        autocomplete="off"
        required
      />
      <ul id="lista-origen" class="autocomplete-list"></ul>
    </div>

    <div class="input-group autocomplete-wrapper">
      <label for="destino">¿A dónde querés ir?</label>
      <input
        type="text"
        id="destino"
        name="destino"
        placeholder="Ej: Mendoza, Argentina"
        autocomplete="off"
        required
      />
      <ul id="lista-destino" class="autocomplete-list"></ul>
    </div>

    <div class="input-group">
      <label>¿Cuándo viajamos?</label>
      <div class="fechas-grid">
        <div class="fecha-caja">
          <span class="fecha-sublabel">Salida 🛫</span>
          <input type="date" id="fecha_inicio" required />
        </div>
        <div class="fecha-caja">
          <span class="fecha-sublabel">Regreso 🛬</span>
          <input type="date" id="fecha_fin" required />
        </div>
      </div>
    </div>

    <div class="row">
      <div class="input-group">
        <label for="cantidad_personas">Pasajeros</label>
        <input
          type="number"
          id="cantidad_personas"
          name="cantidad_personas"
          min="1"
          max="50"
          value="1"
          required
        />
      </div>
      <div class="input-group">
        <label for="medio_transporte">Medio de Transporte</label>
        <select id="medio_transporte" name="medio_transporte" required>
          <option value="AEREA">Avión</option>
          <option value="TERRESTRE">Bus / Auto</option>
          <option value="MARITIMO">Barco / Ferry</option>
          <option value="SIN DEFINIR">Que decida la IA</option>
        </select>
      </div>
    </div>

    <div class="input-group">
      <label for="motivo_viaje">Motivo del Viaje</label>
      <select id="motivo_viaje" name="motivo_viaje" required>
        <option value="VACACIONES">Vacaciones y Ocio</option>
        <option value="RELAX">Descanso y Relax</option>
        <option value="AVENTURA">Turismo Aventura</option>
        <option value="CULTURAL">Cultural e Histórico</option>
        <option value="LUNA_DE_MIEL">Luna de Miel / Romántico</option>
        <option value="TRABAJO">Negocios y Trabajo</option>
      </select>
    </div>

    <button type="submit" id="btn-submit">Generar Opciones con IA 🪄</button>
  </form>
</div>

<style>
  .form-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
    font-family: sans-serif;
  }
  .input-group {
    margin-bottom: 15px;
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    gap: 15px;
  }
  .row .input-group {
    flex: 1;
  }
  input, select {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background-color: #f8fafc;
    color: #1e293b;
    font-size: 1rem;
    transition: all 0.2s ease;
    outline: none;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
  }
  
  input:focus, select:focus {
    border-color: #0ea5e9;
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.15);
    background-color: #ffffff;
  }

  /* === MODO OSCURO (GLOBAL) === */
  :global(.dark) input,
  :global(.dark) select {
    background-color: #1e293b;
    border-color: #334155;
    color: #f8fafc;
    color-scheme: dark;
  }
  :global(.dark) input:focus,
  :global(.dark) select:focus {
    border-color: #0ea5e9;
    background-color: #0f172a;
  }

  /* === GRILLA DE FECHAS === */
  .fechas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 4px;
  }
  .fecha-caja {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: #f8fafc;
    padding: 10px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    transition: all 0.2s ease;
  }
  .fecha-caja:focus-within {
    border-color: #0ea5e9;
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.15);
    background-color: #ffffff;
  }
  .fecha-sublabel {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .fecha-caja input {
    border: none;
    padding: 0;
    background: transparent;
    box-shadow: none;
    height: 24px;
  }
  .fecha-caja input:focus {
    box-shadow: none;
  }

  :global(.dark) .fecha-caja {
    background-color: #1e293b;
    border-color: #334155;
  }
  :global(.dark) .fecha-caja:focus-within {
    background-color: #0f172a;
  }
  :global(.dark) .fecha-sublabel {
    color: #94a3b8;
  }

  /* === LISTA DE AUTOCOMPLETADO === */
  .autocomplete-wrapper {
    position: relative;
  }
  .autocomplete-list {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 220px;
    overflow-y: auto;
    z-index: 1000;
    display: none;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }
  .autocomplete-list li {
    padding: 12px 16px;
    cursor: pointer;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #334155;
    font-weight: 500;
    transition: background-color 0.15s ease;
    margin-bottom: 2px;
  }
  .autocomplete-list li::before {
    content: "📍";
    font-size: 1.2rem;
    opacity: 0.8;
  }
  .autocomplete-list li:hover {
    background-color: #f1f5f9;
    color: #0ea5e9;
  }

  :global(.dark) .autocomplete-list {
    background-color: #1e293b;
    border-color: #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }
  :global(.dark) .autocomplete-list li {
    color: #e2e8f0;
  }
  :global(.dark) .autocomplete-list li:hover {
    background-color: #334155;
    color: #38bdf8;
  }

  /* === BOTÓN SUBMIT === */
  button[type="submit"] {
    margin-top: 10px;
    padding: 16px;
    background: #0ea5e9;
    color: white;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    font-weight: bold;
    font-size: 1.1rem;
    width: 100%;
    transition: all 0.2s ease;
    box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.2);
  }
  button[type="submit"]:hover {
    background: #0284c7;
    transform: translateY(-2px);
    box-shadow: 0 6px 8px -1px rgba(14, 165, 233, 0.3);
  }
</style>

<script>
  import { locationAPI, type Lugar } from "../../services/api/locationAPI";

  document.addEventListener("DOMContentLoaded", () => {
    
    function setupAutocomplete(inputId: string, listId: string) {
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const list = document.getElementById(listId) as HTMLUListElement | null;

      if (!input || !list) return;

      let timeoutId: number | undefined;

      input.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const valor = target.value;

        clearTimeout(timeoutId);

        if (valor.length < 3) {
          list.style.display = "none";
          return;
        }

        timeoutId = window.setTimeout(async () => {
          
          const resultados = await locationAPI.buscarLugares(valor);
          
          list.innerHTML = "";

          if (resultados.length > 0) {
            resultados.forEach((lugar: Lugar) => {
              const li = document.createElement("li");
              li.textContent = lugar.display_name;

              li.addEventListener("click", () => {
                input.value = lugar.display_name;
                list.style.display = "none";
              });

              list.appendChild(li);
            });
            list.style.display = "block";
          } else {
            list.style.display = "none";
          }
        }, 500);
      });

      document.addEventListener("click", (e) => {
        if (e.target !== input && e.target !== list) {
          list.style.display = "none";
        }
      });
    }

    setupAutocomplete("origen", "lista-origen");
    setupAutocomplete("destino", "lista-destino");
  });
</script>
